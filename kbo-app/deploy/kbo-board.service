# /etc/systemd/system/kbo-board.service
# 설치: sudo cp deploy/kbo-board.service /etc/systemd/system/ && sudo systemctl daemon-reload
#       sudo systemctl enable --now kbo-board
[Unit]
Description=KBO Fan Board App
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kbo-app
ExecStart=/usr/bin/node server.js
Environment=PORT=3000
Environment=DATA_DIR=/opt/kbo-app/data
Environment=ADMIN_TOKEN=change-me
Restart=always
RestartSec=3
User=ubuntu

[Install]
WantedBy=multi-user.target
